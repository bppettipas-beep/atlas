// ---------------------------------------------------------------------------
// Atlas — database schema
//
// Design notes:
//  * `Company` is the tenancy boundary. Almost every record carries a
//    `companyId` so the API can enforce "does this row belong to the caller's
//    company?" with a single indexed check.
//  * A `User` is a login. A `Membership` is that user inside one company, and
//    it is the identity everything else points at (tasks, comments, teams...).
//    That lets one person belong to several companies later without duplicating
//    accounts.
//  * Soft deletes are used only where history matters: memberships
//    (deactivatedAt), tasks (archivedAt), teams (archivedAt), documents
//    (archivedAt) and comments (deletedAt). Everything else is hard deleted.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------- enums -------------------------------------

enum CompanyRole {
  OWNER
  CO_OWNER
  MANAGER
  WORKER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  FOCUSED
  OFF_SHIFT
  ON_LEAVE
}

enum OrgNodeKind {
  PERSON
  TEAM
}

enum RelationshipType {
  REPORTS_TO
  TEAM_MEMBER
  COLLABORATES_WITH
  SHARES_SKILL
  OWNS_AREA
  MENTORS
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  AWAITING_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttachmentKind {
  GENERAL
  COMPLETION_PROOF
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DocumentPersonRole {
  OWNER
  CONTRIBUTOR
  AUDIENCE
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_MENTIONED
  TASK_STATUS_CHANGED
  TASK_DUE_CHANGED
  TASK_OVERDUE
  TASK_BLOCKED
  TASK_APPROVED
  TASK_CREATED
  TASK_COMPLETED
  TASK_COMMENTED
  TEAM_ADDED
  MEMBER_JOINED
  MEMBER_LEFT
  ROLE_ASSIGNED
  DOCUMENT_PUBLISHED
  DOCUMENT_ACK_REQUESTED
  ANNOUNCEMENT
}

enum ActivityType {
  MEMBER_JOINED
  MEMBER_ROLE_CHANGED
  MEMBER_DEACTIVATED
  MANAGER_CHANGED
  TEAM_CREATED
  TEAM_UPDATED
  TEAM_MEMBER_ADDED
  TEAM_MEMBER_REMOVED
  TASK_CREATED
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMPLETED
  TASK_BLOCKED
  TASK_APPROVED
  TASK_COMMENTED
  TASK_ESCALATED
  DOCUMENT_CREATED
  DOCUMENT_UPDATED
  DOCUMENT_ACKNOWLEDGED
  INVITE_CREATED
  INVITE_USED
  ANNOUNCEMENT_POSTED
  RELATIONSHIP_CHANGED
}

enum ActivityVisibility {
  COMPANY
  MANAGERS
}

enum ConversationKind {
  COMPANY
  DIRECT
  GROUP
}

enum SubscriptionPlan {
  STARTER
  GROWTH
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
}

// ------------------------------- identity ----------------------------------

model User {
  id String @id @default(cuid())

  email        String  @unique
  /// Null for accounts that only ever sign in with Google. Such a user can set
  /// a password later, which adds a second way in rather than replacing Google.
  passwordHash String?
  /// Google's stable subject id. Preferred over email for matching, because a
  /// Google account can change its email address but never its subject.
  googleId     String? @unique

  fullName    String
  avatarUrl   String?
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@index([email])
}

/// A permanently reserved address. This keeps an account deletion from making
/// the same login address available to a different person later.
model DeletedEmail {
  email     String   @id
  deletedAt DateTime @default(now())
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  industry  String?
  sizeRange String?
  location  String?
  timezone  String   @default("UTC")
  logoUrl   String?
  subscriptionPlan   SubscriptionPlan   @default(STARTER)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  subscriptionExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  roles          Role[]
  teams          Team[]
  inviteCodes    InviteCode[]
  directInvites  DirectInvite[]
  skills         Skill[]
  orgNodes       OrganizationNode[]
  relationships  OrganizationRelationship[]
  tasks          Task[]
  taskTemplates  TaskTemplate[]
  documents      KnowledgeDocument[]
  notifications  Notification[]
  activityEvents ActivityEvent[]
  announcements  Announcement[]
  workingHours   WorkingHours[]
  timeOff        TimeOff[]
  conversations  Conversation[]
}

model Membership {
  id            String           @id @default(cuid())
  userId        String
  companyId     String
  /// Permission tier. Deliberately separate from `roleId` below: this decides
  /// what somebody may *do*, and is enforced on every request.
  role          CompanyRole      @default(WORKER)
  status        MembershipStatus @default(ACTIVE)
  jobTitle      String?
  /// The company's own named role — what somebody *is* on the org chart.
  /// Carries no permissions.
  roleId        String?
  /// A person added by hand who has never signed in — a stand-in for a real
  /// hire, or somebody who does not use a computer. Identical to any other
  /// membership everywhere else: assignable, mappable, editable. Their user
  /// row has no password and no Google link, so it can never be signed into.
  isPlaceholder Boolean          @default(false)
  managerId     String?
  joinedAt      DateTime         @default(now())
  deactivatedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  manager       Membership?  @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  directReports Membership[] @relation("ManagerReports")

  assignedRole Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  profile                EmployeeProfile?
  orgNode                OrganizationNode?
  notificationPreference NotificationPreference?

  teamMemberships TeamMembership[]
  ledTeams        Team[]           @relation("TeamLead")
  memberSkills    MemberSkill[]
  certifications  Certification[]
  trainingRecords TrainingRecord[]
  privateNotes    MemberNote[]     @relation("NoteSubject")
  authoredNotes   MemberNote[]     @relation("NoteAuthor")

  createdTasks   Task[]         @relation("TaskCreator")
  assignedTasks  Task[]         @relation("TaskAssignee")
  approvedTasks  Task[]         @relation("TaskApprover")
  scheduledTasks Task[]         @relation("TaskScheduler")
  workingHours   WorkingHours[]
  timeOff        TimeOff[]      @relation("TimeOffPerson")
  bookedTimeOff  TimeOff[]      @relation("TimeOffBooker")

  comments        TaskComment[]
  mentions        TaskCommentMention[]
  uploads         TaskAttachment[]
  templateDefault TaskTemplate[]       @relation("TemplateAssignee")

  ownedDocuments    KnowledgeDocument[]       @relation("DocumentOwner")
  documentRevisions KnowledgeRevision[]
  documentPeople    KnowledgeDocumentPerson[]
  acknowledgments   KnowledgeAcknowledgment[]

  notifications  Notification[]  @relation("NotificationRecipient")
  actedEvents    ActivityEvent[] @relation("ActivityActor")
  targetedEvents ActivityEvent[] @relation("ActivityTarget")
  createdInvites InviteCode[]    @relation("InviteCreator")
  announcements  Announcement[]
  conversationMembers ConversationMember[]
  sentMessages        ChatMessage[] @relation("MessageSender")
  createdConversations Conversation[] @relation("ConversationCreator")

  @@unique([userId, companyId])
  @@index([companyId, role])
  @@index([companyId, status])
  @@index([managerId])
  @@index([roleId])
}

/// A company's own named role — "Lead Cleaning Technician", "Dispatcher".
///
/// These describe position, not permission. The three permission tiers
/// (OWNER / CO_OWNER / MANAGER / WORKER) stay where they are, because letting people
/// invent roles that grant access would turn every role edit into a security
/// decision. A role here is a label with a colour and a place in a hierarchy.
model Role {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  /// Hex colour used for the chip on the map, the people list and profiles.
  color       String  @default("#121211")
  description String?

  /// The role this one reports into. Null means it sits at the top.
  parentId  String?
  /// Order among siblings. Lower sorts first.
  sortOrder Int     @default(0)
  /// Given to anybody who joins with an invitation code. At most one per company.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      Role?        @relation("RoleHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Role[]       @relation("RoleHierarchy")
  memberships Membership[]

  @@unique([companyId, name])
  @@index([companyId, parentId])
  @@index([companyId, sortOrder])
}

model EmployeeProfile {
  id                String             @id @default(cuid())
  membershipId      String             @unique
  headline          String? // "what this person owns"
  bio               String?
  phone             String?
  workEmail         String?
  location          String?
  timezone          String?
  startDate         DateTime?
  availability      AvailabilityStatus @default(AVAILABLE)
  availabilityNote  String?
  weeklyHoursTarget Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model MemberNote {
  id        String   @id @default(cuid())
  companyId String
  subjectId String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Membership @relation("NoteSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  author  Membership @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([companyId, subjectId])
}

// ------------------------------- teams -------------------------------------

model Team {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  description String?
  color       String?
  leadId      String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    Membership? @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)

  members       TeamMembership[]
  orgNode       OrganizationNode?
  tasks         Task[]
  documents     KnowledgeDocument[]
  taskTemplates TaskTemplate[]
  inviteCodes   InviteCode[]
  directInvites DirectInvite[]

  @@unique([companyId, name])
  @@index([companyId])
}

model TeamMembership {
  id           String   @id @default(cuid())
  teamId       String
  membershipId String
  roleInTeam   String?
  createdAt    DateTime @default(now())

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([teamId, membershipId])
  @@index([membershipId])
}

// ------------------------------- skills ------------------------------------

model Skill {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members MemberSkill[]

  @@unique([companyId, name])
  @@index([companyId])
}

model MemberSkill {
  id           String   @id @default(cuid())
  membershipId String
  skillId      String
  level        Int      @default(3) // 1 = learning ... 5 = expert
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([membershipId, skillId])
  @@index([skillId])
}

model Certification {
  id           String    @id @default(cuid())
  membershipId String
  name         String
  issuer       String?
  issuedAt     DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
}

model TrainingRecord {
  id           String    @id @default(cuid())
  membershipId String
  title        String
  documentId   String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  membership Membership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  document   KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([membershipId])
}

// ------------------------------- invites -----------------------------------

model InviteCode {
  id          String      @id @default(cuid())
  companyId   String
  code        String      @unique
  label       String?
  role        CompanyRole @default(WORKER)
  teamId      String?
  expiresAt   DateTime?
  maxUses     Int?
  useCount    Int         @default(0)
  active      Boolean     @default(true)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team      Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy Membership? @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  directInvites DirectInvite[]

  @@index([companyId, active])
}

model DirectInvite {
  id           String      @id @default(cuid())
  companyId    String
  email        String
  role         CompanyRole @default(WORKER)
  jobTitle     String?
  teamId       String?
  inviteCodeId String?
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team       Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  inviteCode InviteCode? @relation(fields: [inviteCodeId], references: [id], onDelete: SetNull)

  @@unique([companyId, email])
  @@index([companyId])
}

// --------------------------- organization map ------------------------------

model OrganizationNode {
  id           String      @id @default(cuid())
  companyId    String
  kind         OrgNodeKind
  membershipId String?     @unique
  teamId       String?     @unique
  x            Float       @default(0)
  y            Float       @default(0)
  pinned       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  team       Team?       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  outgoing OrganizationRelationship[] @relation("RelationshipSource")
  incoming OrganizationRelationship[] @relation("RelationshipTarget")

  @@index([companyId])
}

model OrganizationRelationship {
  id           String           @id @default(cuid())
  companyId    String
  sourceNodeId String
  targetNodeId String
  type         RelationshipType
  label        String?
  strength     Int              @default(1)
  createdAt    DateTime         @default(now())

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source  OrganizationNode @relation("RelationshipSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target  OrganizationNode @relation("RelationshipTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId, type])
  @@index([companyId, type])
}

// -------------------------------- work -------------------------------------

model Task {
  id                 String       @id @default(cuid())
  companyId          String
  title              String
  description        String?
  status             TaskStatus   @default(NOT_STARTED)
  priority           TaskPriority @default(MEDIUM)
  dueAt              DateTime?
  // When the work is booked to happen. `startAt` already meant this and is
  // reused rather than shadowed by a second "scheduled start", so the Schedule
  // is a view of the task and never a second copy of it. A task is scheduled
  // when it has a startAt; endAt is optional and falls back to a default slot
  // length so older tasks with only a start still render.
  startAt            DateTime?
  endAt              DateTime?
  scheduledById      String?
  location           String?
  completionPercent  Int          @default(0)
  requiresApproval   Boolean      @default(false)
  requiresProofPhoto Boolean      @default(false)
  blockedReason      String?
  blockedAt          DateTime?
  completionNote     String?
  completedAt        DateTime?
  approvedAt         DateTime?
  escalatedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  assigneeId   String?
  createdById  String?
  approvedById String?
  teamId       String?
  documentId   String?
  templateId   String?

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee    Membership?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   Membership?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy  Membership?        @relation("TaskApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  scheduledBy Membership?        @relation("TaskScheduler", fields: [scheduledById], references: [id], onDelete: SetNull)
  team        Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  document    KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  template    TaskTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)

  subtasks      Subtask[]
  comments      TaskComment[]
  attachments   TaskAttachment[]
  events        ActivityEvent[]
  notifications Notification[]

  @@index([companyId, status])
  @@index([companyId, dueAt])
  @@index([assigneeId, status])
  @@index([teamId])
  // The Schedule always asks the same question: what is booked in this company
  // between these two instants.
  @@index([companyId, startAt])
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String?
  body      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  task   Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Membership? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  mentions    TaskCommentMention[]
  attachments TaskAttachment[]

  @@index([taskId, createdAt])
}

model TaskCommentMention {
  id           String   @id @default(cuid())
  commentId    String
  membershipId String
  createdAt    DateTime @default(now())

  comment    TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  membership Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([commentId, membershipId])
  @@index([membershipId])
}

model TaskAttachment {
  id         String         @id @default(cuid())
  taskId     String
  commentId  String?
  uploaderId String?
  kind       AttachmentKind @default(GENERAL)
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  createdAt  DateTime       @default(now())

  task     Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment  TaskComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploader Membership?  @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model TaskTemplate {
  id                 String              @id @default(cuid())
  companyId          String
  name               String
  titleTemplate      String
  description        String?
  checklistItems     String[]            @default([])
  priority           TaskPriority        @default(MEDIUM)
  frequency          RecurrenceFrequency @default(WEEKLY)
  interval           Int                 @default(1)
  weekdays           Int[]               @default([])
  dayOfMonth         Int?
  timeOfDay          String              @default("09:00")
  requiresApproval   Boolean             @default(false)
  requiresProofPhoto Boolean             @default(false)
  active             Boolean             @default(true)
  nextRunAt          DateTime?
  lastGeneratedAt    DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  defaultAssigneeId String?
  teamId            String?

  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultAssignee Membership? @relation("TemplateAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  team            Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)

  tasks Task[]

  @@index([companyId, active])
}

// ----------------------------- knowledge -----------------------------------

model KnowledgeDocument {
  id                     String         @id @default(cuid())
  companyId              String
  title                  String
  slug                   String
  category               String         @default("General")
  excerpt                String?
  contentMarkdown        String         @default("")
  tags                   String[]       @default([])
  status                 DocumentStatus @default(DRAFT)
  requiresAcknowledgment Boolean        @default(false)
  version                Int            @default(1)
  ownerId                String?
  teamId                 String?
  archivedAt             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   Membership? @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  team    Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)

  revisions       KnowledgeRevision[]
  acknowledgments KnowledgeAcknowledgment[]
  people          KnowledgeDocumentPerson[]
  tasks           Task[]
  trainingRecords TrainingRecord[]
  events          ActivityEvent[]

  @@unique([companyId, slug])
  @@index([companyId, category])
  @@index([companyId, status])
}

model KnowledgeRevision {
  id              String   @id @default(cuid())
  documentId      String
  version         Int
  title           String
  contentMarkdown String
  changeNote      String?
  editedById      String?
  createdAt       DateTime @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  editedBy Membership?       @relation(fields: [editedById], references: [id], onDelete: SetNull)

  @@unique([documentId, version])
  @@index([documentId])
}

model KnowledgeAcknowledgment {
  id             String   @id @default(cuid())
  documentId     String
  membershipId   String
  version        Int      @default(1)
  acknowledgedAt DateTime @default(now())

  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  membership Membership        @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([documentId, membershipId])
  @@index([membershipId])
}

model KnowledgeDocumentPerson {
  id           String             @id @default(cuid())
  documentId   String
  membershipId String
  role         DocumentPersonRole @default(AUDIENCE)
  createdAt    DateTime           @default(now())

  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  membership Membership        @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([documentId, membershipId])
  @@index([membershipId])
}

// -------------------------- notifications / feed ---------------------------

model Notification {
  id          String           @id @default(cuid())
  companyId   String
  recipientId String
  actorId     String?
  type        NotificationType
  title       String
  body        String?
  entityType  String?
  entityId    String?
  taskId      String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipient Membership @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([companyId, createdAt])
}

model NotificationPreference {
  id               String   @id @default(cuid())
  membershipId     String   @unique
  taskAssigned     Boolean  @default(true)
  mentions         Boolean  @default(true)
  teamChanges      Boolean  @default(true)
  knowledgeUpdates Boolean  @default(true)
  dueDateChanges   Boolean  @default(true)
  announcements    Boolean  @default(true)
  taskComments     Boolean  @default(true)
  // The owner's view of everything happening in the company they did not do
  // themselves. Only owners and managers are ever sent these, so the switch is
  // inert for a worker rather than needing a separate shape.
  companyActivity  Boolean  @default(true)
  // The master switch for the inbox copy. The switches above decide whether a
  // notification happens at all; this one only decides whether it also leaves
  // the building. On by default, because a notification nobody is in the app
  // to see is the whole reason email exists.
  emailNotifications Boolean @default(true)
  updatedAt        DateTime @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model ActivityEvent {
  id         String             @id @default(cuid())
  companyId  String
  type       ActivityType
  summary    String
  visibility ActivityVisibility @default(COMPANY)
  metadata   Json?
  actorId    String?
  targetId   String?
  teamId     String?
  taskId     String?
  documentId String?
  createdAt  DateTime           @default(now())

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor    Membership?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  target   Membership?        @relation("ActivityTarget", fields: [targetId], references: [id], onDelete: SetNull)
  task     Task?              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  document KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, type])
  @@index([actorId])
}

model Announcement {
  id        String   @id @default(cuid())
  companyId String
  authorId  String?
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  Membership? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

// ----------------------------------- chat ---------------------------------

/// A conversation is either the company room, a direct message, or a private
/// group. Membership rows are the access boundary, so a user can never read a
/// message merely by guessing its id.
model Conversation {
  id        String           @id @default(cuid())
  companyId String
  kind      ConversationKind
  title     String?
  creatorId String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator Membership? @relation("ConversationCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  members ConversationMember[]
  messages ChatMessage[]

  @@index([companyId, kind, updatedAt])
}

model ConversationMember {
  conversationId String
  membershipId   String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([conversationId, membershipId])
  @@index([membershipId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Membership   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ------------------------------ availability -------------------------------
// Deliberately two small models rather than an HR system. Working hours say
// when somebody is normally around; time off says when they are not, whatever
// their normal hours. Everything else — accrual, approval chains, balances —
// is out of scope and should stay that way.

/// One weekday's normal working window for one person.
model WorkingHours {
  id           String @id @default(cuid())
  companyId    String
  membershipId String
  /// 0 = Sunday, matching JavaScript's getDay().
  weekday      Int
  /// Minutes from midnight, local to the company. 540 = 09:00.
  startMinute  Int
  endMinute    Int

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, weekday])
  @@index([companyId])
}

/// A period somebody is unavailable, for any reason.
model TimeOff {
  id           String   @id @default(cuid())
  companyId    String
  membershipId String
  startAt      DateTime
  endAt        DateTime
  note         String?
  createdById  String?
  createdAt    DateTime @default(now())

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membership Membership  @relation("TimeOffPerson", fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy  Membership? @relation("TimeOffBooker", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, startAt])
  @@index([membershipId, startAt])
}
