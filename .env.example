# ---------------------------------------------------------------------------
# Atlas environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Required.
# Local dev with the built-in embedded Postgres (`npm run dev:db`):
#   (the exact string is printed by `npm run dev:db` when it starts)
# Local dev with your own Postgres:
#   postgresql://USER:PASSWORD@localhost:5432/atlas?schema=public
# On Railway: add a PostgreSQL service, then set this to the reference
#   ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5555/postgres?connection_limit=1&pgbouncer=true"

# Secret used to sign access-token JWTs. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# Secret used to hash refresh tokens before they are stored in the database.
# Generate the same way as JWT_SECRET. Required in production.
SESSION_SECRET="replace-me-with-a-different-long-random-string"

# Port the Express + Socket.IO server listens on.
# Railway injects PORT automatically — leave this alone in production.
PORT=4000

# "development" | "production" | "test". Set NODE_ENV=production on Railway.
NODE_ENV=development

# Public origin of the deployed app. Used for CORS and for absolute links.
# Local: http://localhost:5173 (the Vite dev server)
# Railway: https://your-app.up.railway.app
APP_ORIGIN="http://localhost:5173"

# Extra allowed browser origins (comma separated). Usually only needed if you
# host the frontend on a different domain than the API. Optional.
CORS_ORIGINS=""

# Where uploaded task attachments and company logos are written.
# Railway containers have an ephemeral filesystem — attach a Volume mounted at
# this path if you want uploads to survive a redeploy.
UPLOAD_DIR="./uploads"

# Maximum upload size in megabytes.
MAX_UPLOAD_MB=10

# Access-token lifetime (any `ms`-style duration string understood by jsonwebtoken).
ACCESS_TOKEN_TTL="15m"

# Refresh-token lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30

# Set to "true" to force `Secure` cookies. Automatically true when
# NODE_ENV=production. Keep false for plain-http local development.
COOKIE_SECURE=false

# How often (in seconds) the background job scans for overdue tasks and
# recurring-task templates that are due. Set to 0 to disable the scheduler.
SCHEDULER_INTERVAL_SECONDS=60

# Attempts allowed per IP per 15 minutes on sign-in, sign-up, join and account
# deletion. Lower it if you are being probed; the default suits a small team.
AUTH_RATE_LIMIT=40

# ---------------------------------------------------------------------------
# Google sign-in (optional)
# ---------------------------------------------------------------------------
# Leave both blank and the "Continue with Google" button is simply not shown —
# the app never offers a sign-in route it cannot complete.
#
# To enable it, create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this exact
# authorised redirect URI, matching your APP_ORIGIN:
#
#   http://localhost:5173/api/auth/google/callback     (local development)
#   https://your-app.up.railway.app/api/auth/google/callback   (production)
#
# The secret is a credential: keep it out of the repository and set it as a
# Railway variable, never in a committed file.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Test-only
# ---------------------------------------------------------------------------
# Connection string used by `npm test`. If unset, the test suite boots its own
# embedded Postgres on port 5556 automatically.
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5556/postgres?connection_limit=1&pgbouncer=true"
